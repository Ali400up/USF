{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/feed.xml", "destination": "/api/feed" },
    { "source": "/about", "destination": "/api/section-page?section=about" },
    { "source": "/issues", "destination": "/api/section-page?section=issues" },
    { "source": "/news", "destination": "/api/section-page?section=news" },
    { "source": "/activities", "destination": "/api/section-page?section=activities" },
    { "source": "/courses", "destination": "/api/section-page?section=courses" },
    { "source": "/committees", "destination": "/api/section-page?section=committees" },
    { "source": "/achievements", "destination": "/api/section-page?section=achievements" },
    { "source": "/events", "destination": "/api/section-page?section=events" },
    { "source": "/news/:id", "destination": "/api/seo-page?type=news&id=:id" },
    { "source": "/activities/:id", "destination": "/api/seo-page?type=activities&id=:id" },
    { "source": "/courses/:id", "destination": "/api/seo-page?type=courses&id=:id" },
    { "source": "/committees/:id", "destination": "/api/seo-page?type=committees&id=:id" },
    { "source": "/achievements/:id", "destination": "/api/seo-page?type=achievements&id=:id" },
    { "source": "/events/:id", "destination": "/api/seo-page?type=events&id=:id" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400" }
      ]
    }
  ]
}
